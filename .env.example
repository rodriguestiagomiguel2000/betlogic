# BetLogic Server Environment Configuration
PORT=3001
NODE_ENV=production

# Database Connection (e.g. Aiven PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Authentication Secrets
JWT_SECRET=your_super_secure_jwt_session_secret_key

# Google Gemini API Key (Server-side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Render Node/DNS Connectivity Tweaks (if applicable)
RPC_DNS_RESOLVER=
PREFER_IPV4=true
